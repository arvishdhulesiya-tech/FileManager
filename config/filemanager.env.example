# FileManager runtime configuration.
# Copy these values into your Tomcat/service environment. Do NOT commit real passwords.

FILEMANAGER_ADMIN_USERNAME=admin
FILEMANAGER_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Semicolon-separated directories the application is allowed to browse.
FILEMANAGER_ROOTS=/data

FILEMANAGER_READ_ONLY=false
FILEMANAGER_ALLOW_UPLOAD=true
FILEMANAGER_NATIVE_COMMANDS=false
FILEMANAGER_RESTRICT_BROWSING=true
FILEMANAGER_RESTRICT_WHITELIST=true
FILEMANAGER_COMMAND_TIMEOUT_MS=30000
